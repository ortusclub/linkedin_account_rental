{
  "manifest_version": 3,
  "name": "Profile Fingerprint Override",
  "version": "1.0.0",
  "description": "Enforces consistent browser fingerprint for anti-detection",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
